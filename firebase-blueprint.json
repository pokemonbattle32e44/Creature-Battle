{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles, team, PC box, inventory, stats, ranking, and admin status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "nickname": { "type": "string" },
        "avatar": { "type": "string" },
        "money": { "type": "number" },
        "isAdmin": { "type": "boolean" },
        "elo": { "type": "number" },
        "league": { "type": "string" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "winStreak": { "type": "number" },
        "team": { "type": "array" },
        "pcBox": { "type": "array" },
        "inventory": { "type": "object" },
        "pokedexCaught": { "type": "array" },
        "pokedexSeen": { "type": "array" },
        "favoritePokemonId": { "type": "number" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email", "nickname"]
    },
    "friends": {
      "title": "Friends",
      "description": "Friendships between users",
      "type": "object",
      "properties": {
        "userA": { "type": "string" },
        "userB": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "friendRequests": {
      "title": "Friend Requests",
      "description": "Pending friend invitations",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "fromNickname": { "type": "string" },
        "toUid": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "gifts": {
      "title": "Gifts",
      "description": "Gifts sent between players (Pokemon, items, money)",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "fromNickname": { "type": "string" },
        "toUid": { "type": "string" },
        "type": { "type": "string" },
        "payload": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
