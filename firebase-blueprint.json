        "winnerUid": { "type": "string" },
        "logs": { "type": "array" },
        "createdAt": { "type": "string" }
      }
    },
    "logs": {
      "title": "Logs",
      "description": "System activity logs for battles, trades, and gifts",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "participants": { "type": "array" },
        "detail": { "type": "string" },
        "timestamp": { "type": "string" }
      }
